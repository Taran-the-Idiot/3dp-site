---
import Layout from '../layouts/Layout.astro';
import { site, pricing } from '../data/site';
---

<Layout
  title="Get a quote"
  description="Request a 3D printing quote in Sydney. Send your STL files, choose a material and tell us the size — we will come back with an exact price."
>
  <section class="head">
    <div class="shell">
      <span class="eyebrow">Get a quote</span>
      <h1>Tell us what you need printed</h1>
      <p class="lede">
        Send your STL files, the material and the rough size of the part. Quotes are free and usually take less
        than one business day.
      </p>
    </div>
  </section>

  <section>
    <div class="shell layout">
      <!-- Fillout enquiry form -->
      <div class="form-wrap">
        <div
          style="width:100%;height:500px;"
          data-fillout-id="aivaD3EtXjus"
          data-fillout-embed-type="standard"
          data-fillout-inherit-parameters
          data-fillout-dynamic-resize
        >
        </div>
        <script src="https://server.fillout.com/embed/v1/" is:inline></script>
      </div>

      <!-- Sidebar -->
      <aside class="side">
        <div class="card">
          <h2>Or reach us directly</h2>
          <ul class="contact-list">
            <li><span class="lbl">Email:</span> <a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><span class="lbl">Phone:</span> <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
            <li><span class="lbl">Based in:</span> {site.location}</li>
          </ul>
        </div>

        <div class="card">
          <h3>Good to know</h3>
          <dl>
            <div>
              <dt>Pricing</dt>
              <dd>From ${pricing.fromPerKg} {pricing.currency}/kg + shipping.</dd>
            </div>
            <div>
              <dt>Turnaround</dt>
              <dd>{site.turnaround}</dd>
            </div>
            <div>
              <dt>Shipping</dt>
              <dd>{site.shipping}</dd>
            </div>
            <div>
              <dt>File types</dt>
              <dd>STL, 3MF, OBJ and STEP. No model? Send a sketch and we will draw it.</dd>
            </div>
          </dl>
        </div>

        <div class="card">
          <h3>Speed up your quote</h3>
          <ul class="tips">
            <li>Include overall dimensions in millimetres.</li>
            <li>Say what the part has to do — looks, strength or flex.</li>
            <li>Mention colour references or a hex code.</li>
            <li>Let us know your deadline.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .head {
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .form-wrap {
    min-width: 0;
  }

  /* sidebar */
  .side {
    display: grid;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .side h2,
  .side h3 {
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .side dt {
    font-weight: 500;
    margin-top: 0.4rem;
  }

  .side dd {
    margin: 0;
    color: var(--text-muted);
  }

  .side dl > div:first-child dt {
    margin-top: 0;
  }

  .contact-list li {
    margin-bottom: 0.3rem;
  }

  .contact-list a {
    color: var(--accent);
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .lbl {
    color: var(--text-dim);
  }

  .tips li {
    padding-left: 1rem;
    position: relative;
    color: var(--text-muted);
    margin-bottom: 0.15rem;
  }
  .tips li:before {
    content: '–';
    position: absolute;
    left: 0;
  }

  @media (max-width: 800px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
