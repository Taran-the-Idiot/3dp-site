---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Past prints' },
  { href: '/enquire', label: 'Get a quote' },
];
---

<header class="site-header">
  <div class="shell bar">
    <a class="brand" href="/">
      <img src="/logo.png" alt="" width="203" height="215" />
      <span>{site.name}</span>
    </a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">Menu</button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class={`${path === l.href ? 'is-active' : ''} ${l.href === '/enquire' ? 'cta' : ''}`}
              aria-current={path === l.href ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .brand img {
    width: auto;
    height: 34px;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a.is-active {
    color: var(--text);
    font-weight: 600;
  }

  .nav a.cta {
    background: var(--accent);
    color: #fff;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
  }

  .menu-toggle {
    display: none;
    padding: 0.25rem 0.6rem;
    font-size: 0.85rem;
    font-family: inherit;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .menu-toggle {
      display: block;
    }
    .nav {
      display: none;
      width: 100%;
      padding-bottom: 0.75rem;
    }
    .nav.is-open {
      display: block;
    }
    .bar {
      flex-wrap: wrap;
    }
    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
