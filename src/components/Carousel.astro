---
import type { Print } from '../data/prints';

interface Props {
  items: Print[];
}

const { items } = Astro.props;

// Repeat the set enough times that the widest view (4 slides) always has
// real slides to move into, so the loop never runs out of images.
const copies = Math.max(2, Math.ceil((items.length + 4) / items.length));
const loop = Array.from({ length: copies }, (_, copy) =>
  items.map((item) => ({ item, clone: copy > 0 }))
).flat();
---

<div class="carousel" data-carousel data-count={items.length} aria-label="Photos of prints we have made" role="region">
  <button class="arrow" data-prev aria-label="Previous">‹</button>

  <div class="window">
    <ul class="track" data-track>
      {loop.map(({ item, clone }) => (
        <li class="slide" aria-hidden={clone ? 'true' : undefined}>
          <img src={item.image} alt={clone ? '' : item.alt} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>

  <button class="arrow" data-next aria-label="Next">›</button>
</div>

<style>
  .carousel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .window {
    flex: 1;
    overflow: hidden;
  }

  .track {
    display: flex;
  }

  .slide {
    flex: 0 0 25%;
    padding: 0 0.25rem;
  }

  .slide img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .arrow {
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .arrow:hover {
    background: var(--bg-alt);
  }

  @media (max-width: 900px) {
    .slide {
      flex-basis: 33.333%;
    }
  }

  @media (max-width: 600px) {
    .slide {
      flex-basis: 50%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    // number of real (non-clone) slides — one full lap of the loop
    const count = Number(root.dataset.count ?? 0);
    if (count === 0) return;

    const perView = () => {
      if (window.innerWidth <= 600) return 2;
      if (window.innerWidth <= 900) return 3;
      return 4;
    };

    let index = 0;

    const position = (animate: boolean) => {
      track.style.transition = animate ? 'transform 0.4s ease' : 'none';
      track.style.transform = `translateX(-${index * (100 / perView())}%)`;
    };

    const next = () => {
      // if a lap finished but has not been reset yet (rapid clicks), reset now
      // so the index never runs past the cloned slides
      if (index >= count) {
        index -= count;
        position(false);
        void track.offsetWidth;
      }
      index++;
      position(true);
    };

    const prev = () => {
      // stepping back past the start: jump forward a full lap first, with no
      // animation, so there is always a slide to move onto
      if (index === 0) {
        index = count;
        position(false);
        void track.offsetWidth; // force the jump to apply before animating
      }
      index--;
      position(true);
    };

    // once a full lap has been animated, snap back by one lap. The slide on
    // screen is identical, so the reset is invisible.
    track.addEventListener('transitionend', () => {
      if (index >= count) {
        index -= count;
        position(false);
      }
    });

    root.querySelector('[data-prev]')?.addEventListener('click', prev);
    root.querySelector('[data-next]')?.addEventListener('click', next);

    window.addEventListener('resize', () => position(false));

    let timer = setInterval(next, 3000);
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', () => {
      timer = setInterval(next, 3000);
    });

    position(false);
  });
</script>
