---
import { site, pricing } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="cols">
      <div>
        <h4>{site.name}</h4>
        <p>{site.location}</p>
        <p>From ${pricing.fromPerKg} {pricing.currency}/kg + shipping</p>
      </div>

      <div>
        <h4>Pages</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/gallery">Past prints</a></li>
          <li><a href="/enquire">Get a quote</a></li>
        </ul>
      </div>

      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/services#multicolour">Multicolour printing</a></li>
          <li><a href="/services#materials">PLA, PETG & TPU</a></li>
          <li><a href="/services#modelling">3D modelling</a></li>
          <li><a href="/services#finishing">Finishing & assembly</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
        </ul>
      </div>
    </div>

    <p class="copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
    padding: 1.5rem 0 1rem;
    font-size: 0.85rem;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1.4fr;
    gap: 1.5rem;
  }

  h4 {
    margin-bottom: 0.4rem;
  }

  .site-footer p {
    margin: 0 0 0.2rem;
    color: var(--text-muted);
  }

  .cols li {
    margin-bottom: 0.2rem;
  }

  .cols a {
    color: var(--text-muted);
    text-decoration: none;
    overflow-wrap: break-word;
  }
  .cols a:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  .copy {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
  }
</style>
